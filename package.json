{
  "name": "short-url-react-node",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "lint": "eslint frontend backend tests scripts",
    "test": "vitest run",
    "test:mysql": "node --env-file=backend/.env scripts/test-mysql.mjs",
    "test:outage": "node --env-file=backend/.env scripts/test-outage.mjs",
    "audit:prod": "node scripts/dependency-audit.mjs",
    "docs:diagrams": "node scripts/diagrams-doc.mjs && node scripts/render-diagrams.mjs",
    "test:e2e": "node --env-file=backend/.env scripts/test-e2e.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:dev": "npm run db:dev -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:local": "node --env-file=backend/.env scripts/seed-local-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "deepmerge-ts": "8.0.2",
    "eslint": "9.39.5",
    "jsdom": "28.1.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.11"
  }
}

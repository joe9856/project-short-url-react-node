generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Char(36)
  name String @db.VarChar(100)
  email String @unique @db.VarChar(254)
  passwordHash String @map("password_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  links Link[]
  sessions Session[]
  @@map("users")
}
model Session {
  tokenHash String @id @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("sessions")
}
model Link {
  id String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  originalUrl String @map("original_url") @db.Text
  code String @unique @db.VarChar(32)
  isActive Boolean @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickEvents ClickEvent[]
  @@index([userId, createdAt])
  @@map("links")
}
model ClickEvent {
  id String @id @default(uuid()) @db.Char(36)
  linkId String @map("link_id") @db.Char(36)
  clickedAt DateTime @default(now()) @map("clicked_at") @db.DateTime(3)
  referrerHost String? @map("referrer_host") @db.VarChar(253)
  deviceType String @map("device_type") @db.VarChar(16)
  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  @@index([linkId, clickedAt])
  @@map("click_events")
}
model RateLimit {
  key String @id @db.Char(64)
  count Int @default(1)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  @@index([expiresAt])
  @@map("rate_limits")
}
